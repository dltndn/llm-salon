# Copy this file to ~/.llm-salon/.env and fill in the keys you plan to use.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/llm_salon?schema=public"
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Optional overrides
# LLM_SALON_PORT=4477
# LLM_SALON_CONTEXT_PROFILE=medium
# LLM_SALON_OUTPUT_LANGUAGE=en   # one of: en, ko, ja, zh, es, fr, de
